# Reference configuration only: this project does not automatically load .env.
# Set these variables in your shell/IDE, or explicitly load a private .env file.
# Never commit actual credentials, tokens, key files, or populated .env files.

# Option A: a standard Snowflake connections.toml profile supplies authentication.
# The database/schema below intentionally select this project's public schema.
SNOWFLAKE_CONNECTION_NAME=

# Option B: explicit connector settings. Required when no named profile is used.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
# Leave blank to use a named profile's authenticator, or the password default.
SNOWFLAKE_AUTHENTICATOR=
SNOWFLAKE_PASSWORD=

# For browser SSO set SNOWFLAKE_AUTHENTICATOR=externalbrowser (no password).
# For key-pair auth set SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT and the key path.
SNOWFLAKE_PRIVATE_KEY_FILE=
SNOWFLAKE_PRIVATE_KEY_FILE_PWD=
# For OAuth set SNOWFLAKE_AUTHENTICATOR=oauth and supply the token.
SNOWFLAKE_TOKEN=

SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=INSURANCE_ANALYTICS
SNOWFLAKE_SCHEMA=RETENTION
SNOWFLAKE_LOGIN_TIMEOUT=60

# Logical table names are fixed to keep the feature/source contracts aligned:
# POLICY_EXPOSURE_HISTORY -> POLICY_RETENTION_13_1
# Database/schema values must be unquoted SQL identifiers. The guarded build
# renderer substitutes these values into the supplied SQL template.
